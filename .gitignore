# .gitignore

.env
.env.*
!.env.example

.runtime/
projects/*/.runtime/
raw secret material
temporary logs
*.log
*.tmp
*.bak

embedding/vector indexes
vector-store/
.cache/
__pycache__/

# Keep human-readable knowledge tracked
# do not ignore approved governance or memory files

# Runtime records and private evidence never belong in this public repository.
private/
private-data/
*.invictus
Invictus-register-*.json
Invictus-Private-Register*.json
*.xlsx
*.xls
*.csv
*.pdf
node_modules/
dist/
qa-*.png
private-*.png
.DS_Store
