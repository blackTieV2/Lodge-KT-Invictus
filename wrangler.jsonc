{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invictus-register",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "invictus.layer-8-labs.com", "custom_domain": true}],
  "assets": {"directory": "./online-dist", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "invictus-register", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "observability": {"enabled": false}
}
